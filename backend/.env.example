# InternAssist Backend Environment Configuration Example
# Copy this file to .env (or backend/.env) and populate with your environment-specific values.

# Application Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5001

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///internassist.db
# PostgreSQL deployment example (requires psycopg2-binary):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/internassist

# Initial Administrator Account (created on startup if not existing)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password

# Session Configuration
# Supported backends: filesystem, redis, sqlalchemy
SESSION_TYPE=filesystem
SESSION_FILE_DIR=flask_session
# For cross-site deployments (e.g. Vercel frontend + Render backend):
# In production, SESSION_COOKIE_SAMESITE defaults to None and SESSION_COOKIE_SECURE defaults to true.
# In local development over HTTP:
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Redis Configuration (Chat history cache & optional session store)
REDIS_URL=redis://localhost:6379/0
# Alternatively configure individual connection parameters:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_TIMEOUT=2.0
REDIS_CHAT_TTL=3600

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Document Storage & ChromaDB
UPLOAD_FOLDER=uploads
CHROMA_DB_PATH=chroma_db

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT=25.0
