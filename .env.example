# Flask API root. Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:5001/api

# Backend (place these in backend/.env for local development)
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
DATABASE_URL=sqlite:///internassist.db
GEMINI_API_KEY=
REDIS_URL=
CHROMA_DB_PATH=backend/chroma_db
MAX_UPLOAD_BYTES=20971520

# Optional bootstrap account. No default administrator is created unless both are set.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
